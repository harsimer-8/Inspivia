# ---- Vercel environment variables for the Inspivia frontend (all SERVER-ONLY) ----
# Base URL of the main Python backend on Render, WITHOUT a trailing slash and WITHOUT /api/v1.
BACKEND_API_URL=https://your-backend.onrender.com

# Optional tuning (milliseconds). Defaults: 15000 for auth calls, 45000 for AI chat.
# BACKEND_TIMEOUT_MS=15000
# BACKEND_AI_TIMEOUT_MS=45000

# NOTE: GEMINI_API_KEY and AI_SERVICE_API_KEY must NOT be set on the frontend.
# They belong only to the backend / Quaithe services on Render.
