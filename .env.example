# Copy to .env and fill in. Never commit .env.
DB_NAME=inspivia
DB_USERNAME=inspivia
DB_PASSWORD=change-me
JWT_SECRET=generate-with-openssl-rand-base64-48
# Set true only when the application is served over HTTPS.
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAIL_HOST=mailhog
MAIL_PORT=1025
# Keep false for local MailHog. Set true for authenticated providers such as Brevo on port 587.
MAIL_USE_TLS=false
# Brevo: smtp-relay.brevo.com:587, Brevo account login as username, SMTP key as password.
MAIL_FROM=no-reply@inspivia.local
ADMIN_EMAIL=
ADMIN_PASSWORD=
# When using Docker Compose, use http://host.docker.internal:8000 for an AI service
# running on the Windows host, or http://ai-service:8000 if ai-service joins this network.
AI_SERVICE_BASE_URL=http://ai-service:8000
# Generate once and set the same value on the FastAPI service. It is sent as X-Service-Key.
AI_SERVICE_API_KEY=replace-with-a-long-random-secret
